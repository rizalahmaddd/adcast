{
  "name": "adcast",
  "private": true,
  "version": "0.1.0",
  "description": "Sistem manajemen tayangan video untuk banyak TV sekaligus, berjalan di Cloudflare Workers, D1, R2, dan Durable Objects.",
  "license": "MIT",
  "author": "rizalahmaddd",
  "homepage": "https://adcast.biz.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizalahmaddd/adcast.git"
  },
  "bugs": {
    "url": "https://github.com/rizalahmaddd/adcast/issues"
  },
  "keywords": [
    "digital-signage",
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-r2",
    "durable-objects",
    "hono",
    "react",
    "tailwindcss",
    "typescript",
    "multi-tenant"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -b",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply adcast --local",
    "db:migrate:remote": "wrangler d1 migrations apply adcast --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.17",
    "lucide-react": "^1.72.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
